$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 About {
  coords 6223.731 87.833 11204.077
  m_sTitle "О миссии"
  m_sTextData "Миссия по мотивам событий афганистана 2007 года"\
  ""\
  "Подготовил Tynec для Тушино"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 Rules {
  coords 6214.704 87.17 11219.865
  m_sTitle "Условности"
  m_sTextData "—Всем запрещено  надевать вражескую униформу, разгрузки, бронежелеты, и рюкзаки можно."\
  ""\
  "—Для победы одной из сторон надо удержать флаг до конца мисии на здание администрации (отмечено на карте)"\
  ""\
  "—На миссии присуствуют гражданские под управлением ИИ, а также скрипт, который следит, чтобы вы их не убивали. Убийства гражданских карается поражением вашей стороны."\
  ""\
  "—Время на миссию 35 минут"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 MEI_task {
  coords 6212.876 87.153 11217.834
  m_sTitle "Задача"
  m_sTextData "Наш брат заметил колонну американцев движушиюся сюда, все кто может сражатся берите оружие. Встретим их здесь!"\
  ""\
  "Наша задача до конца наступления удержать флаг над здание администрации (35 минут)."\
  ""\
  "Помните, что в городе полно гражданских, которых не могут убивать американцы. Наше единственное различие между жителями города - это оружие. Комбинацией клавиш tab+x вы можете быстро сбросить оружие и скрыться в толпе гражданских. В городе полно тайников с оружием"
  m_aVisibleForFactions {
   "MEI"
  }
  m_iOrder 2
 }
 USAF_task {
  coords 6217.268 87.214 11218.935
  m_sTitle "Задача"
  m_sTextData "Нашему подразделению приказано занять город Расман, для контроля стратегически важной инфраструктуры. "\
  ""\
  "Для победы надо удержать флаг над зданием администрации к концу операции (35 минут)"\
  ""\
  "Помните, что в городе полно гражданских. Их нельзя убивать, однако противник может прятатся в толпе. Будьте бдительны, черезмерные гражданские жертвы вынудят нас отступить."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 2
 }
}