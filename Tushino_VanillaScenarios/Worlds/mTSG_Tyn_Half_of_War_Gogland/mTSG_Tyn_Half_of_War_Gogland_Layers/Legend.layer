$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 About {
  coords 6856.243 138.546 2449.93
  m_sTitle "О миссии"
  m_sTextData "Добро пожаловать в бункер, удачи!"\
  ""\
  "Подготовил Tynec для Tushino Serios Games"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 Rules {
  coords 6861.891 138.546 2453.204
  m_sTitle "Условности"
  m_sTextData "Условности для всех"\
  "—Всем запрещенно снимать любой элмент экипировки, исключение: Бронижелеты, разгрузки, рюкзаки, головные уборы."\
  "—Всем запрещено надевать вражеские элементы экипировки, исключение: Рюкзаки, разгрузки, бронежелеты."\
  ""\
  "Условности для ВС РФ"\
  "—Для победы нужно убить и подтвердить смерть лидера боевиков и отменить запуск ракеты через пульт управления."\
  ""\
  "Условности для боевиков"\
  "—Запрещено пересекать красны маркер, в случае пересечения игра вас предупредит о нарушение."\
  "—Для победы нужно 40 мин не давать отменить запуск ракеты и сохранить жизнь КСу. Либо уничтожить всех атакующих"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 AFRF_TASK {
  coords 6857.662 138.546 2451.045
  m_sTitle "Задача"
  m_sTextData "Некая группа боевкиов захватила пусковую шахту и угрожают запустить баллистическую ракету и спровоцировать войну"\
  ""\
  "Наша задача: уничтожить лидера боевиков и опознать его тело, а также отменить запуск баллистической ракеты"
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
  m_iOrder 2
 }
 RNRF_TASK {
  coords 6863.668 138.394 2457.563
  m_sTitle "Задача"
  m_sTextData "Война — это искусство обмана! Многие годы лицемерие Запада превращало весь мир в поле битвы. Пока враги народа трепали языками, наши братья и наши сыновья проливали свою кровь. Но обман — обоюдоострое оружие. Чем чудовищнее ложь, тем охотнее в неё верить. А когда целая нация требует возмездия, ложь распространяется со скоростью лесного пожара. ©Владимир Макаров"\
  ""\
  "Наша задача: не дать отменить запуск баллистической ракеты, а также сохранить жизнь нашего лидера."
  m_aVisibleForFactions {
   "Tyn_RNRF"
  }
  m_iOrder 2
 }
}